<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright 2026 Florian MAZEN
  SPDX-License-Identifier: Apache-2.0

  Packages dist/qsp-style.css as a jar served by Spring Boot at /qsp-style/qsp-style.css.
  Build the package first (yarn build), then: mvn -Drevision=1.2.3 package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.f4fez</groupId>
  <artifactId>qsp-style</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>qsp-style</name>
  <description>QSP visual identity: CSS variables and base styles for server-rendered pages.</description>
  <url>https://github.com/Ham-QSP/qsp-web</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <revision>0.0.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/Ham-QSP/qsp-web</url>
    </repository>
  </distributionManagement>

  <build>
    <resources>
      <resource>
        <directory>dist</directory>
        <includes>
          <include>qsp-style.css</include>
        </includes>
        <targetPath>META-INF/resources/qsp-style</targetPath>
      </resource>
      <resource>
        <directory>.</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-built-css</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.basedir}/dist/qsp-style.css</file>
                  </files>
                  <message>dist/qsp-style.css is missing: run yarn build first.</message>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
